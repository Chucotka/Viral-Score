# Copy to .env.local for local development.

GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
UNLOCK_SECRET=
BLOB_READ_WRITE_TOKEN=
# Тот же API key, что TRIBUTE_API_KEY в viral-maker-ai (Tribute Dashboard → API Keys)
TRIBUTE_WEBHOOK_SECRET=

# ── Public app config (served via GET /api/public-config, no secrets) ──
BOT_USERNAME=viral_score_bot
FREE_TIER_LIMIT=3
BILLING_MODE=stars
STARS_MONTHLY_PRICE=350
PREMIUM_ACCESS_DAYS=30
PREMIUM_RUB_MONTHLY=490
TRIBUTE_URL=
CARD_CHECKOUT_URL=

# Operator access (server-only, never sent to regular users)
# Comma-separated clientIds, e.g. local:abc123 or tg:123456789
DEVELOPER_CLIENT_IDS=
# Comma-separated Telegram user IDs (Mini App maps to clientId tg:<id>)
TELEGRAM_DEV_USER_IDS=
# One-time setup URL token: https://your-app/?setup=<token> reveals launch panel
ADMIN_SETUP_TOKEN=
